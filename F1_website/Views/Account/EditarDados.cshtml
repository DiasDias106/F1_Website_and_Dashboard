@model F1_website.Models.paginacomunicaçãoviewmodel
@{
    ViewBag.Title = "Editar Dados";
}

@section Styles {
    <link rel="stylesheet" href="~/estilos/editar_user.css" />
}

<section class="edit_height">
    <div class="edit-page-container">
        <div class="edit-background-pattern"></div>
        <div class="edit-racing-line"></div>
        <div class="edit-racing-line-2"></div>

        <div class="edit-speed-indicator">
            >>> 320 KM/H
        </div>

        <div class="edit-container">
            <div class="edit-f1-logo">
                <div class="edit-logo-text">F</div>
                <h2 class="edit-title">Editar Dados do Piloto</h2>
            </div>

            <div class="edit-content">
                <section id="editForm">
                    @using (Html.BeginForm("EditarDados", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        <h4 class="edit-section-title">Informações Pessoais</h4>

                        @Html.ValidationSummary(true, "", new { @class = "edit-validation-summary" })

                        <div class="edit-form-group">
                            @Html.LabelFor(m => m.Painel.Nome, new { @class = "edit-form-label" })
                            <div class="edit-input-wrapper">
                                @Html.TextBoxFor(m => m.Painel.Nome, new { @class = "edit-form-input", placeholder = "Digite o seu nome completo" })
                                @Html.ValidationMessageFor(m => m.Painel.Nome, "", new { @class = "edit-validation-message" })
                            </div>
                        </div>

                        <div class="edit-form-group">
                            @Html.LabelFor(m => m.Painel.Email, new { @class = "edit-form-label" })
                            <div class="edit-input-wrapper">
                                @Html.TextBoxFor(m => m.Painel.Email, new { @class = "edit-form-input", placeholder = "Digite o seu email", type = "email" })
                                @Html.ValidationMessageFor(m => m.Painel.Email, "", new { @class = "edit-validation-message" })
                            </div>
                        </div>

                        <div class="edit-form-group">
                            @Html.LabelFor(m => m.Painel.Morada, new { @class = "edit-form-label" })
                            <div class="edit-input-wrapper">
                                @Html.TextBoxFor(m => m.Painel.Morada, new { @class = "edit-form-input", placeholder = "Digite a sua morada completa" })
                                @Html.ValidationMessageFor(m => m.Painel.Morada, "", new { @class = "edit-validation-message" })
                            </div>
                        </div>

                        <div class="edit-form-group">
                            @Html.LabelFor(m => m.Painel.DataNascimento, new { @class = "edit-form-label" })
                            <div class="edit-input-wrapper">
                                @Html.TextBoxFor(m => m.Painel.DataNascimento, "{0:yyyy-MM-dd}", new { @class = "edit-form-input", type = "date" })
                                @Html.ValidationMessageFor(m => m.Painel.DataNascimento, "", new { @class = "edit-validation-message" })
                            </div>
                        </div>

                        <div class="edit-button-group">
                            <button type="submit" class="edit-button edit-button-primary">
                                Guardar Alterações
                            </button>
                            @Html.ActionLink("Cancelar", "Painel", "Account", null, new { @class = "edit-button edit-button-secondary" })
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Add focus effects to form inputs
            $('.edit-form-input').on('focus', function () {
                $(this).closest('.edit-input-wrapper').addClass('focused');
                $(this).css('transform', 'scale(1.02)');
            }).on('blur', function () {
                $(this).closest('.edit-input-wrapper').removeClass('focused');
                $(this).css('transform', 'scale(1)');
            });

            // Add entrance animation
            $('.edit-container').css({
                'opacity': '0',
                'transform': 'translateY(50px)'
            }).animate({
                'opacity': '1'
            }, 800, function () {
                $(this).css('transform', 'translateY(0)');
            });

            // Enhanced button hover effects
            $('.edit-button-primary').hover(
                function () {
                    $(this).css('box-shadow', '0 15px 35px rgba(255, 24, 1, 0.5), 0 0 40px rgba(255, 24, 1, 0.4)');
                },
                function () {
                    $(this).css('box-shadow', '0 10px 25px rgba(255, 24, 1, 0.4), 0 0 30px rgba(255, 24, 1, 0.3)');
                }
            );

            $('.edit-button-secondary').hover(
                function () {
                    $(this).css({
                        'background': 'rgba(255, 255, 255, 0.2)',
                        'border-color': 'rgba(255, 255, 255, 0.5)',
                        'transform': 'translateY(-2px)',
                        'box-shadow': '0 10px 25px rgba(255, 255, 255, 0.1)'
                    });
                },
                function () {
                    $(this).css({
                        'background': 'rgba(255, 255, 255, 0.1)',
                        'border-color': 'rgba(255, 255, 255, 0.3)',
                        'transform': 'translateY(0)',
                        'box-shadow': 'none'
                    });
                }
            );

            // Add pulse animation to speed indicator
            $('.edit-speed-indicator').addClass('edit-pulse-animation');

            // Form validation enhancement
            $('.edit-form-input').on('input', function () {
                var $this = $(this);
                var $wrapper = $this.closest('.edit-input-wrapper');

                if ($this.val().length > 0) {
                    $wrapper.addClass('has-content');
                } else {
                    $wrapper.removeClass('has-content');
                }
            });

            // Initialize has-content class for pre-filled inputs
            $('.edit-form-input').each(function () {
                var $this = $(this);
                var $wrapper = $this.closest('.edit-input-wrapper');

                if ($this.val().length > 0) {
                    $wrapper.addClass('has-content');
                }
            });

            // Add typing effect to title
            var title = $('.edit-title');
            var originalText = title.text();
            title.text('');

            setTimeout(function () {
                var i = 0;
                var typeInterval = setInterval(function () {
                    title.text(originalText.substr(0, i));
                    i++;
                    if (i > originalText.length) {
                        clearInterval(typeInterval);
                    }
                }, 50);
            }, 500);
        });
    </script>
}