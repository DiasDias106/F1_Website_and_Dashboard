@model F1_website.Models.paginacomunicaçãoviewmodel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/estilos/registos.css" />
}

<!-- Elementos de fundo animados -->
<div class="background-pattern"></div>

<!-- Linhas de fundo iguais à página de login -->
<div class="racing-line"></div>
<div class="racing-line-2"></div>

<!-- Indicador de velocidade -->
<div class="speed-label">REGISTER MODE</div>

<div class="site-wrapper">
    <div class="register-container">
        <!-- Header -->
        <div class="register-header">
            <div class="brand-logo">F</div>
            <h2 class="register-title">@ViewBag.Title</h2>
            <p class="register-subtitle">Create a new account</p>
        </div>

        <!-- Divisor -->
        <div class="section-divider">
            <div class="divider-line"></div>
            <div class="divider-text">Account Details</div>
            <div class="divider-line"></div>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })

            <!-- Grid de campos -->
            <div class="form-grid">
                <!-- Username -->
                <div class="form-group">
                    @Html.LabelFor(m => m.Register.UserName, new { @class = "col-form-label" })
                    @Html.TextBoxFor(m => m.Register.UserName, new { @class = "form-control", placeholder = "Enter your username" })
                    @Html.ValidationMessageFor(m => m.Register.UserName, "", new { @class = "text-danger" })
                </div>

                <!-- Nome -->
                <div class="form-group">
                    @Html.LabelFor(m => m.Register.Nome, new { @class = "col-form-label" })
                    @Html.TextBoxFor(m => m.Register.Nome, new { @class = "form-control", placeholder = "Enter your full name" })
                    @Html.ValidationMessageFor(m => m.Register.Nome, "", new { @class = "text-danger" })
                </div>

                <!-- Email -->
                <div class="form-group form-group-full">
                    @Html.LabelFor(m => m.Register.Email, new { @class = "col-form-label" })
                    @Html.TextBoxFor(m => m.Register.Email, new { @class = "form-control", placeholder = "Enter your email address" })
                    @Html.ValidationMessageFor(m => m.Register.Email, "", new { @class = "text-danger" })
                </div>

                <!-- Password -->
                <div class="form-group">
                    @Html.LabelFor(m => m.Register.Password, new { @class = "col-form-label" })
                    @Html.PasswordFor(m => m.Register.Password, new { @class = "form-control", placeholder = "Create a password" })
                    @Html.ValidationMessageFor(m => m.Register.Password, "", new { @class = "text-danger" })
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    @Html.LabelFor(m => m.Register.ConfirmPassword, new { @class = "col-form-label" })
                    @Html.PasswordFor(m => m.Register.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm your password" })
                    @Html.ValidationMessageFor(m => m.Register.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <!-- Morada -->
                <div class="form-group form-group-full">
                    @Html.LabelFor(m => m.Register.Morada, new { @class = "col-form-label" })
                    @Html.TextBoxFor(m => m.Register.Morada, new { @class = "form-control", placeholder = "Enter your address" })
                    @Html.ValidationMessageFor(m => m.Register.Morada, "", new { @class = "text-danger" })
                </div>

                <!-- Data de Nascimento -->
                <div class="form-group">
                    @Html.LabelFor(m => m.Register.DataNascimento, new { @class = "col-form-label" })
                    @Html.TextBoxFor(m => m.Register.DataNascimento, new
                    {
                        @class = "form-control",
                        type = "date",
                        value = Model.Register.DataNascimento.ToString("yyyy-MM-dd"),
                        max = DateTime.Today.ToString("yyyy-MM-dd")
                    })
                    @Html.ValidationMessageFor(m => m.Register.DataNascimento, "", new { @class = "text-danger" })
                </div>

                <!-- Foto -->
                <div class="form-group">
                    @Html.Label("Foto", new { @class = "col-form-label" })
                    <input type="file" name="FotoFile" class="form-control" accept="image/*" style="padding: 12px 16px !important; color: rgba(255,255,255,0.7) !important;" />
                </div>
            </div>

            <!-- Botão de submit -->
            <div class="submit-container">
                <input type="submit" value="Register" class="btn btn-outline-dark" />
            </div>
        }

        <!-- Link alternativo -->
        <div class="alt-link" style="text-align: center; margin-top: 25px;">
            <p style="color: rgba(255,255,255,0.7);">
                Already have an account?
                @Html.ActionLink("Sign in here", "Login", "Account", null, new { style = "color: #ff1801; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" })
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Configurar data máxima
            $('input[type="date"]').attr('max', new Date().toISOString().split('T')[0]);

            // Placeholders dinâmicos
            $('input[name="Register.UserName"]').attr('placeholder', 'Enter your username');
            $('input[name="Register.Nome"]').attr('placeholder', 'Enter your full name');
            $('input[name="Register.Email"]').attr('placeholder', 'Enter your email address');
            $('input[name="Register.Password"]').attr('placeholder', 'Create a password');
            $('input[name="Register.ConfirmPassword"]').attr('placeholder', 'Confirm your password');
            $('input[name="Register.Morada"]').attr('placeholder', 'Enter your address');

            // Estilo para arquivo selecionado
            $('input[type="file"]').on('change', function () {
                var fileName = $(this).val().split('\\').pop();
                if (fileName) {
                    $(this).css({
                        'color': '#ff1801 !important',
                        'font-weight': '600'
                    });
                }
            });

            // Animações de delay para os campos
            $('.form-group').each(function (index) {
                $(this).css({
                    'animation-delay': (index * 0.1) + 's',
                    'animation-fill-mode': 'both'
                });
            });

            // Estados de focus
            $('.form-control').on('focus', function () {
                $(this).parent().addClass('focused');
            }).on('blur', function () {
                $(this).parent().removeClass('focused');
            });

            // Remover erros durante digitação
            $('.form-control').on('input', function () {
                var $this = $(this);
                var $errorMsg = $this.siblings('.text-danger');
                if ($this.val().trim() !== '') {
                    $this.removeClass('error');
                    $errorMsg.fadeOut();
                }
            });

            // Hover no botão
            $('.btn-outline-dark').hover(
                function () {
                    $(this).css('transform', 'translateY(-3px)');
                },
                function () {
                    $(this).css('transform', 'translateY(0)');
                }
            );
        });
    </script>
}

<style>
    .form-group.focused .form-control {
        border-color: #ff1801 !important;
        box-shadow: 0 0 0 4px rgba(255, 24, 1, 0.25) !important;
    }

    .form-control.error {
        border-color: #ff6b6b !important;
        box-shadow: 0 0 0 4px rgba(255, 107, 107, 0.25) !important;
    }

    .alt-link a:hover {
        color: #ffffff !important;
        text-shadow: 0 0 15px rgba(255, 24, 1, 1) !important;
    }
</style>