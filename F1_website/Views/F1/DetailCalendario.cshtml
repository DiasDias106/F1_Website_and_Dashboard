@model F1_website.Models.paginacomunicaçãoviewmodel
@{
    ViewBag.Title = "Detalhes do Calendário";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link rel="stylesheet" href="~/estilos/estilos_f1_detail.css"/>
}
<div class="f1-calendar-details">
    <div class="f1-header">
        <h2>Detalhes do Evento F1</h2>
    </div>

    <div class="f1-container">
        <div class="f1-event-card f1-loading-animation">
            <h4>Informações do Evento</h4>

            <div class="f1-details-grid">
                <div class="f1-detail-item f1-loading-animation">
                    <dt>@Html.DisplayNameFor(model => model.Calendario.nome_evento)</dt>
                    <dd>@Html.DisplayFor(model => model.Calendario.nome_evento)</dd>
                </div>

                <div class="f1-detail-item f1-loading-animation">
                    <dt>@Html.DisplayNameFor(model => model.Calendario.data_inicio)</dt>
                    <dd>@Html.DisplayFor(model => model.Calendario.data_inicio)</dd>
                </div>

                <div class="f1-detail-item f1-loading-animation">
                    <dt>@Html.DisplayNameFor(model => model.Calendario.data_fim)</dt>
                    <dd>@Html.DisplayFor(model => model.Calendario.data_fim)</dd>
                </div>

                <div class="f1-detail-item f1-loading-animation">
                    <dt>@Html.DisplayNameFor(model => model.Calendario.duracao)</dt>
                    <dd>@Html.DisplayFor(model => model.Calendario.duracao)</dd>
                </div>

                <div class="f1-detail-item f1-description-item f1-loading-animation">
                    <dt>@Html.DisplayNameFor(model => model.Calendario.descricao)</dt>
                    <dd>@Html.DisplayFor(model => model.Calendario.descricao)</dd>
                </div>
            </div>

            @Html.ActionLink("Voltar à Lista", "ListaCalendario", null, new { @class = "f1-back-button" })
        </div>
    </div>
</div>