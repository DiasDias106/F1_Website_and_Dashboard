@model F1_website.Models.paginacomunicaçãoviewmodel

@{
    ViewBag.Title = "Lista de Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="padding-top:120px">Eventos do Calendário</h2>
<h3 style="color:red">@ViewBag.Msg</h3>

<p>
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalAddCalendario">Criar Evento</button>
</p>

<!-- Modal: criar evento -->
<div class="modal fade" id="modalAddCalendario" tabindex="-1" aria-labelledby="modalAddCalendarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="modalAddCalendarioLabel" class="modal-title">Criar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("AddCalendario", "F1", FormMethod.Post, new { id = "formCreateCalendario" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label>Nome do Evento</label>
                        <input name="Calendario.nome_evento" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Data de Início</label>
                        <input type="date" name="Calendario.data_inicio" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Data de Fim</label>
                        <input type="date" name="Calendario.data_fim" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Duração (dias)</label>
                        <input type="number" name="Calendario.duracao" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Descrição</label>
                        <textarea name="Calendario.descricao" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>Pista</label>
                        @Html.DropDownList("Calendario.pista", new SelectList(Model.Pistas, "Id_pista", "nome"), "-- selecionar --", new { @class = "form-control", required = "required" })
                    </div>
                    <button type="submit" class="btn btn-success">Criar Evento</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: editar evento -->
<div class="modal fade" id="modalEditCalendario" tabindex="-1" aria-labelledby="modalEditCalendarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="modalEditCalendarioLabel" class="modal-title">Editar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("EditCalendario", "F1", FormMethod.Post, new { id = "formEditCalendario" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("Id_evento", "", new { id = "editId_evento" })
                    <div class="mb-3">
                        <label>Nome do Evento</label>
                        <input type="text" name="nome_evento" id="editNome_evento" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Data de Início</label>
                        <input type="date" name="data_inicio" id="editData_inicio" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Data de Fim</label>
                        <input type="date" name="data_fim" id="editData_fim" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Duração</label>
                        <input type="number" name="duracao" id="editDuracao" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Descrição</label>
                        <textarea name="descricao" id="editDescricao" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>Pista</label>
                        @Html.DropDownList("pista", new SelectList(Model.Pistas, "Id_pista", "nome"), null, new { @id = "editPista", @class = "form-control" })
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar Alterações</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: apagar evento -->
<div class="modal fade" id="modalDeleteCalendario" tabindex="-1" aria-labelledby="modalDeleteCalendarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="modalDeleteCalendarioLabel" class="modal-title">Apagar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Tem a certeza que pretende eliminar este evento?</p>
                <p><strong id="deleteNomeEvento"></strong></p>
                @using (Html.BeginForm("DeleteCalendario", "F1", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("Id_evento", "", new { id = "deleteId_evento" })
                    <button type="submit" class="btn btn-danger">Apagar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tabela de eventos -->
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Evento</th>
            <th>Início</th>
            <th>Fim</th>
            <th>Duração</th>
            <th>Descrição</th>
            <th>Pista</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CalendariosPaginados)
        {
            <tr>
                <td>@item.nome_evento</td>
                <td>@item.data_inicio.ToString("yyyy-MM-dd")</td>
                <td>@item.data_fim.ToString("yyyy-MM-dd")</td>
                <td>@item.duracao</td>
                <td>@item.descricao</td>
                <td>@item.Pista1.nome</td>
                <td>
                    <a href="@Url.Action("DetailCalendario", "F1", new { id = item.Id_evento })" class="btn btn-info btn-sm">Detalhes</a>
                    <button class="btn btn-warning btn-sm btn-edit-cal" data-bs-toggle="modal" data-bs-target="#modalEditCalendario"
                            data-id="@item.Id_evento" data-nome="@Html.AttributeEncode(item.nome_evento)"
                            data-inicio="@item.data_inicio.ToString("yyyy-MM-dd")"
                            data-fim="@item.data_fim.ToString("yyyy-MM-dd")"
                            data-duracao="@item.duracao"
                            data-descricao="@Html.AttributeEncode(item.descricao)"
                            data-idpista="@item.pista">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm btn-delete-cal" data-bs-toggle="modal" data-bs-target="#modalDeleteCalendario"
                            data-id="@item.Id_evento" data-nome="@Html.AttributeEncode(item.nome_evento)">
                        Apagar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Script para preencher os modais -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.btn-edit-cal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editId_evento').value = btn.dataset.id;
                document.getElementById('editNome_evento').value = btn.dataset.nome;
                document.getElementById('editData_inicio').value = btn.dataset.inicio;
                document.getElementById('editData_fim').value = btn.dataset.fim;
                document.getElementById('editDuracao').value = btn.dataset.duracao;
                document.getElementById('editDescricao').value = btn.dataset.descricao;
                document.getElementById('editPista').value = btn.dataset.idpista;
            });
        });

        document.querySelectorAll('.btn-delete-cal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteId_evento').value = btn.dataset.id;
                document.getElementById('deleteNomeEvento').textContent = btn.dataset.nome;
            });
        });
    });
</script>
