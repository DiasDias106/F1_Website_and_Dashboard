@model F1_website.Models.paginacomunicaçãoviewmodel


@{
    ViewBag.Title = "Contact";
}
@section contactos_styles{
    <link rel="stylesheet" href="~/estilos/contactos.css" />
    <link rel="stylesheet" href="~/estilos/videos.css" />
}

<section class="contactos_bac">
    <section class="contactos">
        <div class="sec_alinha">
            <div class="sec_contactos">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3800.8026384459818!2d-9.162942409616049!3d38.76858341201119!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd1932edd62bb521%3A0x1ee0de4e32108704!2sISTEC%20-%20Instituto%20Superior%20de%20Tecnologias%20Avan%C3%A7adas!5e0!3m2!1spt-PT!2spt!4v1746890292898!5m2!1spt-PT!2spt" width="80%" height="500" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </section>

    <section class="info_contacto">
        <h2>Contactos</h2>
        <ul>
            <li><strong>Telefone:</strong> +351 912 345 678</li>
            <li><strong>Email:</strong> contacto@forumula.pt</li>
            <li><strong>Morada:</strong> Alameda das Linhas de Torres, Lisboa</li>
        </ul>
    </section>

    <section class="form_contacto">
        <div class="form_logo">
            <img src="~/imagens/layout/forum_logo3.png" alt="Logo Formula Forum" />
        </div>
        <div class="form_email">
            <h2>Diga-nos a sua opinião</h2>
            @using (Html.BeginForm("EnviarEmail", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("origem", "Contact")

                <div>
                    @Html.LabelFor(m => m.Email.Destinatario)
                    @Html.TextBoxFor(m => m.Email.Destinatario)
                    @Html.ValidationMessageFor(m => m.Email.Destinatario)
                </div>

                <div>
                    @Html.LabelFor(m => m.Email.Assunto)
                    @Html.TextBoxFor(m => m.Email.Assunto)
                    @Html.ValidationMessageFor(m => m.Email.Assunto)
                </div>

                <div>
                    @Html.LabelFor(m => m.Email.Corpo)
                    @Html.TextAreaFor(m => m.Email.Corpo)
                    @Html.ValidationMessageFor(m => m.Email.Corpo)
                </div>
                <button type="submit">Enviar</button>
            }
        </div>
    </section>
</section>