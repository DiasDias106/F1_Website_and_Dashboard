@model F1_website.Models.Pilotos

@using (Html.BeginForm("EditPiloto", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id_piloto)

    <div class="form-group">
        @Html.LabelFor(model => model.nome)
        @Html.TextBoxFor(model => model.nome, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.nome, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.nm_equipa)
        @Html.TextBoxFor(model => model.nm_equipa, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.nm_equipa, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.Label("Imagem atual:")
        @if (!string.IsNullOrEmpty(Model.imagem))
        {
            <div>
                <img src="@Url.Content(Model.imagem)" width="100" />
            </div>
        }
    </div>

    <div class="form-group">
        @Html.Label("Nova imagem")
        <input type="file" name="novaImagem" class="form-control" />
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.descricao)
        @Html.TextBoxFor(model => model.descricao, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.descricao, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.titulos)
        @Html.TextBoxFor(model => model.titulos, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.titulos, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.nacionalidade)
        @Html.TextBoxFor(model => model.nacionalidade, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.nacionalidade, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.pontos)
        @Html.TextBoxFor(model => model.pontos, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.pontos, "", new { @class = "text-danger" })
    </div>

    <div class="form-group text-right">
        <input type="submit" value="Guardar Alterações" class="btn btn-primary" />
    </div>
}
