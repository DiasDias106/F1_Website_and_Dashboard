
@{
    ViewBag.Title = "Music_smooth";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section music_styles{
    <link rel="stylesheet" href="~/estilos/musicas.css" />
}

<div class="contentor_musica">
    <header class="music_header">
        <div class="m_logo">Music Player</div>
        <div class="linha_music">Musica a toda a Velocidade</div>
        <div class="checkered-flag"></div>
    </header>

    <div class="music_image">
        <img class="music_main_image" src="~/imagens/Musicas/smooth_operator_music.jpg" alt="Smooth operator" />
    </div>
    <iframe id="f1music8"
            width="0"
            height="0"
            src="https://www.youtube.com/embed/UNk6LTZYokk?enablejsapi=1&autoplay=1&controls=0&loop=1&playlist=UNk6LTZYokk&mute=0"
            frameborder="0"
            allow="autoplay; encrypted-media"
            style="opacity: 0; pointer-events: none; position: absolute;">
    </iframe>
    <div class="alinha_musicb">
        <button class="musicbutton" onclick="playVideo8()">▶️ Play</button>
        <button class="musicbutton" onclick="pauseVideo8()">⏸️ Pausar</button>
    </div>

    <div class="racing-stripe"></div>

    <div class="music-info">
        <h2>PLAYLIST OFICIAL F1</h2>
        <ul class="music-list">
            <li class="music-item">
                <a href="@Url.Action("Music_Max", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Max Verstappen</div>
                    <div class="song-info">
                        <span>Carte Blanq & Maxx Power</span>
                        <span>Max Theme Music • 2:51</span>
                    </div>
                </div>
            </li>

            <li class="music-item">
                <a href="@Url.Action("Music_Fernando", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Fernando Alonso</div>
                    <div class="song-info">
                        <span>Carte Blanq & Maxx Power</span>
                        <span>Alonso Theme Music • 3:16</span>
                    </div>
                </div>
            </li>

            <li class="music-item">
                <a href="@Url.Action("Music_lewis", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Lewis Hamilton</div>
                    <div class="song-info">
                        <span>Carte Blanq & Maxx Power</span>
                        <span>Hamilton Theme music • 2:23</span>
                    </div>
                </div>
            </li>

            <li class="music-item">
                <a href="@Url.Action("Music_Lando", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Lando Norris</div>
                    <div class="song-info">
                        <span>Carte Blanq & Maxx Power</span>
                        <span>Norris Theme Music • 2:41</span>
                    </div>
                </div>
            </li>

            <li class="music-item">
                <a href="@Url.Action("Music_Perez", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Checo</div>
                    <div class="song-info">
                        <span>Carte Blanq & Maxx Power</span>
                        <span>Perez Theme Music • 3:00</span>
                    </div>
                </div>
            </li>

            <li class="music-item">
                <a href="@Url.Action("Music_f1theme", "Home")" class="play-icon">
                    ▶
                </a>
                <div class="music-details">
                    <div class="song-title">Racing Day</div>
                    <div class="song-info">
                        <span>Brian Tyler</span>
                        <span>F1 Official • 6:37</span>
                    </div>
                </div>
            </li>
        </ul>
    </div>
</div>
@section music_scripts{
    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        let player8;

        function onYouTubeIframeAPIReady() {
            player8 = new YT.Player('f1music8');
        }

        function playVideo8() {
            if (player8 && typeof player8.playVideo === 'function') {
                player8.playVideo();
            }
        }

        function pauseVideo8() {
            if (player8 && typeof player8.pauseVideo === 'function') {
                player8.pauseVideo();
            }
        }
    </script>
}


