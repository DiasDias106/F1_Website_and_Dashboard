
@{
    ViewBag.Title = "Noticias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section noticias_style{
    <link rel="stylesheet" href="~/estilos/videos.css"/>
    <link rel="stylesheet" href="~/estilos/noticias.css"/>
}
<section class="contentor_noticias">
    <div style="padding-top:120px" class="alinha">
        <section class="riscas1">
        </section>
    </div>
    <div style="padding-top:20px" class="header-wrapper">
        <div class="stripe"></div>
        <div class="stripe"></div>
        <h1 class="title">Noticias</h1>
    </div>
    <div class="pequeno_titulo1">
        Noticias Ultima Hora
        <div class="barra-titulo1">
            <div class="barra1 top"></div>
            <div class="barra1 bottom"></div>
        </div>
    </div>
    <div class="cont_cartao">
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/mercedes_novo_sponser.jpg" />
            </div>
            <div class="cartao-content">
                <h3 style="text-align:center" class="cartao-title">Mudanças na equipa da Mercedes</h3>
                <p class="cartao-description">Nesta epoca de 2025 a mercedes iniciou parceria com a Adidas e com a SAP</p>
            </div>
        </div>

        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/alpine_nova_parceria.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novas Parcerias da Alpine</h3>
                <p class="cartao-description">A Alpine anunciou em 2025 novas grandes parcerias</p>
            </div>
        </div>
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/max_guinness_record.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novo Record de Max</h3>
                <p class="cartao-description">Max Verstappen obteve um novo record no guinness</p>
            </div>
        </div>
    </div>
    <div class="cont_cartao">
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/nova_equipa.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Em 2026 aparece uma nova equipa</h3>
                <p class="cartao-description">Em 2026 a cadillac vai juntar-se ao campeonato da F1</p>
            </div>
        </div>

        <div class="cartao_vid">
            <div class="video-contentor">
                <<img src="~/imagens/Noticias/verstappen_win_record.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novo Record de Vitorias</h3>
                <p class="cartao-description">O piloto MAx Verstappen atinge um novo marco batendo o record de Vitorias</p>
            </div>
        </div>
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/novo_sponser.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novo Sponser na F1</h3>
                <p class="cartao-description">F1 anuncias uma nova parceria com Globant</p>
            </div>
        </div>
    </div>
    <div class="pequeno_titulo1">
        Noticias da Temporada
        <div class="barra-titulo1">
            <div  class="barra1 top"></div>
            <div class="barra1 bottom"></div>
        </div>
    </div>
    <div class="cont_cartao">
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/noticias_sobre_transmição.png" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novas transmições de F1 em Portugal</h3>
                <p class="cartao-description">A empresa DAZN recebe direitos de transmição da F1 entre 2025 e 2027</p>
            </div>
        </div>

        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/sauber_news.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novo carro da Sauber</h3>
                <p class="cartao-description">A equipa Sauber mostra o seu novo carro num exibição</p>
            </div>
        </div>
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/most_points.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Oscar Piastri em 1º Lugar</h3>
                <p class="cartao-description">Oscar Piastri da equipa Mclaren encontra-se em primeiro lugar no campenato</p>
            </div>
        </div>
    </div>
    <div class="cont_cartao">
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/grnd_prix_usa.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Evento no circuito da America</h3>
                <p class="cartao-description">Foi revelada a lista de Eventos no Circuito da America</p>
            </div>
        </div>

        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/lewis_hamilthon_new_team.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Nova Equipa de Lewis Hamilton</h3>
                <p class="cartao-description">Ferrari anuncia o seu novo membro Lewis Hamilton</p>
            </div>
        </div>
        <div class="cartao_vid">
            <div class="video-contentor">
                <img src="~/imagens/Noticias/f1_2025_game.jpg" />
            </div>
            <div class="cartao-content">
                <h3  style="text-align:center" class="cartao-title">Novo jogo da F1 anunciado</h3>
                <p class="cartao-description">Veja os detalhes do novo jogo da F1</p>
            </div>
        </div>
    </div>
</section>
