            </div>
            <div class="info-item">
                <h3>Team Chief</h3>
                <p>James Vowles</p>
            </div>
            <div class="info-item">
                <h3>Technical Chief</h3>
                <p>Pat Fry</p>
            </div>
            <div class="info-item">
                <h3>Chassi</h3>
                <p>FW47</p>
            </div>
            <div class="info-item">
                <h3>Power Unit</h3>
                <p>Mercedes</p>
            </div>
        </div>

        <div class="drivers">
            <div class="driver-card">
                <div class="driver-img">
                    <img style="width:250px;height:250px;" src="~/imagens/racers/albon.jpg" alt="Piastri">
                </div>
                <div class="driver-info">
                    <h3>Alexander Albon</h3>
                    <p>Número: 23</p>
                    <p>Nacionalidade: Tailandes</p>
                </div>
            </div>
            <div class="driver-card">
                <div class="driver-img">
                    <img style="width:250px;height:250px;" src="~/imagens/racers/sainz.jpg" alt="Norris">
                </div>
                <div class="driver-info">
