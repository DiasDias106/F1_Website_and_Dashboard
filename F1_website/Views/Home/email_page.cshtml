@model F1_website.Models.paginacomunicaçãoviewmodel

@{
    ViewBag.Title = "email_page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Email_styles{
    <link rel="stylesheet" href="~/estilos/Email_styles.css" />
}

<section class="email_corpo">
    <div class="racing-stripes"></div>
    <div class="contentor_email">
        <div class="checkered-flag"></div>
        <div class="speed-lines"></div>

        <div class="logotipo">
            <h1>Email</h1>
            <div class="pequeno_titulo">High Speed Communication</div>
        </div>

        <div class="form_email">
            @using (Html.BeginForm("EnviarEmail", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("origem", "email_page")

                <div class="form-group">
                    @Html.LabelFor(m => m.Email.Destinatario, "Destinatário")
                    @Html.TextBoxFor(m => m.Email.Destinatario, new { @class = "form-control", placeholder = "destinatario@email.com", type = "email", required = "required" })
                    @Html.ValidationMessageFor(m => m.Email.Destinatario)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email.Assunto, "Assunto")
                    @Html.TextBoxFor(m => m.Email.Assunto, new { @class = "form-control", placeholder = "Assunto do email", required = "required" })
                    @Html.ValidationMessageFor(m => m.Email.Assunto)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email.Corpo, "Corpo do Email")
                    @Html.TextAreaFor(m => m.Email.Corpo, new { @class = "form-control", rows = "8", placeholder = "Introduza o conteúdo do seu email aqui...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Email.Corpo)
                </div>

                <button type="submit" class="racing-button" id="btnEnviar">
                    <span>Enviar Email</span>
                </button>
            }
        </div>

    </div>
</section>
@section Email_js{
    <script src="~/javascript/email_interativo.js"></script>

}
