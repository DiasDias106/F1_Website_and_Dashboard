
@{
    ViewBag.Title = "f1Teams";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section f1team_styles{
    <link rel="stylesheet" href="~/estilos/f1team.css" />
    <link rel="stylesheet" href="~/estilos/Pesquisas.css"/>
}


<div style="margin-top:100px" class="alinha">
    <section class="riscas">
    </section>
</div>

<div class="header-wrapper">
    <div class="stripe"></div>
    <div class="stripe"></div>
    <h1 class="title">F1 TEAMS 2025</h1>
</div>
<section>
    <h6 style="margin-left:3%;margin-bottom:20px" class="subtitle">Descobre tudo o que precisas de saber sobre as equipas deste ano:</h6>
</section>

<div class="search-container">
    <input type="text" id="pesquisa" placeholder="Pesquisar página..." />
    <div id="ss" class="sugestoes"></div>
</div>

<section style="margin-bottom: 2rem;" class="alinha">
    <div class="teamc-container">
        <div class="teamc one">
            <a style="cursor:pointer" href="@Url.Action("redBull_racing", "Home")">
                <img style="background: linear-gradient(135deg, #1E1F2B 0%, #0C1C4A 50%, #FF0000 100%);" src="~/imagens/carros/red-bull-racing_car-background.png" alt="red_bull_car">
            </a>
            <div class="teamc-content">
                <h3>Conhece mais sobre a equipa</h3>
                <p>Aprende Mais sobre a Redbull Aqui:</p>
            </div>
        </div>

        <div class="teamc two">
            <a style="cursor:pointer" href="@Url.Action("Ferrari", "Home")">
            <img style="background: linear-gradient(135deg, #ff2800 0%, #000000 100%);" src="~/imagens/carros/ferrari_car-background.png" alt="Pessoa observando a paisagem"></a>
            <div class="teamc-content">
                <h3>Conhece mais sobre a equipa</h3>
                <p>Aprende Mais sobre a Ferrari Aqui:</p>
