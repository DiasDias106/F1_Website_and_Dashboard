
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <link rel="stylesheet" href="~/Content/bootstrap.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.5.0/remixicon.min.css">
    <link rel="icon" href="~/imagens/icons/forum_ico.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/estilos/nav_footer.css">
    <link href="https://fonts.googleapis.com/css2?family=Atomic+Age&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atomic+Age&family=Montserrat+Alternates:wght@400;500&family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
</head>
<body>
    @model F1_website.Models.paginacomunicaçãoviewmodel
    <div id="Layout">
        <header class="header" id="header">
            <nav class="nav container">
                <a href="@Url.Action("pagina_principal", "Home")" class="nav_logo">
                    <img src="@Url.Content("~/imagens/layout/forum_icon2.png")" style="height: 60px" />
                </a>
                <div class="nav__menu" id="nav-menu">
                    <ul class="nav__list">
                        <li class="nav__item">
                            <a href="@Url.Action("pagina_principal", "Home")" class="nav__link">
                                <i class="ri-arrow-right-up-line"></i>
                                <span>Home</span>
                            </a>
                        </li>

                        <li class="nav__item">
                            <a href="@Url.Action("About", "Home")" class="nav__link">
                                <i class="ri-arrow-right-up-line"></i>
                                <span>Conteudos</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="@Url.Action("f1Teams", "Home")">Equipas</a></li>
                                <li><a href="@Url.Action("Constituintes", "Home")">Componentes</a></li>
                                <li><a href="@Url.Action("videos", "Home")">Videos</a></li>
                                <li><a href="@Url.Action("Equipas", "Home")">Gestor de Equipas</a></li>
                                <li><a href="@Url.Action("ListaPistas", "F1")">Pistas</a></li>
                                <li><a href="@Url.Action("ListaCalendario", "F1")">Calendario</a></li>
                            </ul>
                        </li>

                        <li class="nav__item dropdown">
                            <a href="@Url.Action("jogos_hub", "Home")" class="nav__link">
                                <i class="ri-arrow-right-up-line"></i>
                                <span>Aplicações</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="@Url.Action("Imcpage", "Home")">IMC</a></li>
                                <li><a href="@Url.Action("Adivinha_num", "Home")">Adivinha numero</a></li>
                                <li><a href="@Url.Action("calculadora", "Home")">Calculadora</a></li>
                                <li><a href="@Url.Action("conversor_moedas", "Home")">Coversor de Moedas</a></li>
                                <li><a href="@Url.Action("converter_imagem", "Home")">Coversor de Imagens</a></li>
                                <li><a href="@Url.Action("falador", "Home")">Conversor de texto em som</a></li>
                                <li> <a href="@Url.Action("Encriptador", "Home")">Encriptador de Texto</a></li>
                                <li><a href="@Url.Action("jogoForca", "Home")">Jogo da Forca</a></li>
                                <li> <a href="@Url.Action("central_infos", "Home")">Central de Informação</a></li>

                            </ul>
                        </li>

                        <li class="nav__item">
                            <a href="@Url.Action("Musicas_hub", "Home")" class="nav__link">
                                <i class="ri-arrow-right-up-line"></i>
                                <span>Musicas</span>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("Music_Max", "Home")">33 Max Verstappen</a></li>
                                    <li><a href="@Url.Action("Music_smooth", "Home")">Smooth Operator</a></li>
                                    <li><a href="@Url.Action("Music_Fernando", "Home")">Fernando Alonso</a></li>
                                    <li><a href="@Url.Action("Music_leclerc", "Home")">Charles Leclerc</a></li>
                                    <li><a href="@Url.Action("Music_lewis", "Home")">Lewis Hamilton</a></li>
                                    <li><a href="@Url.Action("Music_Lando", "Home")">Lando Norris</a></li>
                                    <li> <a href="@Url.Action("Music_Piastri", "Home")">Piastri</a></li>
                                    <li><a href="@Url.Action("Music_Perez", "Home")">Checo</a></li>
                                    <li> <a href="@Url.Action("Music_f1theme", "Home")">F1 Theme</a></li>

                                </ul>
                            </a>
                        </li>

                        <li class="nav__item">
                            <a href="@Url.Action("Contactos_Hub","Home")" class="nav__link">
                                <i class="ri-arrow-right-up-line"></i>
                                <span>Contactos</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="@Url.Action("Login","Account")">Login</a></li>
                                <li><a href="@Url.Action("Register","Account")">Sign in</a></li>
                                <li><a href="@Url.Action("email_page", "Home")">Email</a></li>
                                <li><a href="@Url.Action("Contact", "Home")">Localização</a></li>
                                <li><a href="@Url.Action("Noticias", "Home")">Noticias</a></li>
                                <li><a href="@Url.Action("Creditos", "Home")">Criador</a></li>
                                <li><a href="@Url.Action("Treeview1", "Home")">Descarregaveis</a></li>
                                @if (User.IsInRole("Chefe") || User.IsInRole("Admin"))
                                {
                                    <li><a href="@Url.Action("dashboard_loading", "Home")">F1 Manager</a></li>
                                }
                            </ul>
                        </li>
                    </ul>

                    <div class="nav__close" id="nav-close">
                        <i class="ri-close-large-line"></i>
                    </div>

                    <div class="nav__social">
                        <a href="@Url.Action("ListaCalendario","F1")" target="_blank" class="nav__social-link">
                            <i class="ri-trophy-fill"></i>
                        </a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.Action("Painel","Account")" class="nav__social-link">
                                <i class="fa-solid fa-user-check"></i>
                            </a>
                        }
                        else
                        { 
                            <a href="@Url.Action("Login","Account")" target="_blank" class="nav__social-link">
                                <i class="fa-solid fa-user"></i>
                            </a>
                        }
                        <a href="@Url.Action("f1Teams","Home")" target="_blank" class="nav__social-link">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </a>
                        <a href="@Url.Action("Contact", "Home")" target="_blank" class="nav__social-link">
                            <i class="fa-solid fa-location-dot"></i>
                        </a>
                    </div>
                </div>

                <div class="nav__toggle" id="nav-toggle" style="padding-right: 30px">
                    <i class="ri-menu-line"></i>
                </div>
            </nav>
        </header>
        @RenderBody()
        <footer>
            <div id="footer_content">
                <div id="footer_contacts">
                    <img src="~/imagens/layout/forum_icon2.png" style="width: 150px;height:auto">

                    <div id="footer_social_media">
                        <a href="#" class="footer-link" id="instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#" class="footer-link" id="github">
                            <i class="fa-brands fa-github"></i>
                        </a>
                        <a href="#" class="footer-link" id="linkdin">
                            <i class="fa-brands fa-linkedin"></i>
                        </a>
                    </div>
                </div>
                <ul class="footer-list">
                    <li>
                        <h3>Forum</h3>
                    </li>
                    <li>
                        <a href="@Url.Action("jogos_hub", "Home")" class="footer-link">Aplicações</a>
                    </li>
                    <li>
                        <a href="@Url.Action("Noticias", "Home")" class="footer-link">Noticias</a>
                    </li>
                    <li>
                        <a href="@Url.Action("videos", "Home")" class="footer-link">Videos</a>
                    </li>
                </ul>
                <ul class="footer-list">
                    <li>
                        <h3>Dashboard</h3>
                    </li>
                    <li>
                        <a href="@Url.Action("dashboard_main", "Home")" class="footer-link">Painel</a>
                    </li>
                    <li>
                        <a href="@Url.Action("dashboard_analises", "Home")" class="footer-link">Analises</a>
                    </li>
                    <li>
                        <a href="@Url.Action("dashboard_funcoes", "Home")" class="footer-link">Funcionalidades</a>
                    </li>
                </ul>
                <div id="footer_subscribe">
                    <h3>Subscribe</h3>
                    <p>
                        Enter your email to get notified about
                        our news solutions
                    </p>
                    <div class="form_newsletter">
                        <form action="/Home/EnviarNewsletter" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <div id="input_group">
                                <input type="email" name="Email" placeholder="O seu email" id="email" required />
                                <button type="submit" name="enviar_newsletter">
                                    <i class="fa-solid fa-envelope"></i>
                                </button>
                            </div>
                        </form>

                        @if (TempData["Mensagem"] != null)
                        {
                            <div class="alert-message">@TempData["Mensagem"]</div>
                        }
                    </div>
                </div>
            </div>
            <div id="footer_copyright">
                &#169
                2025 all right reserved
            </div>
        </footer>
    </div>
    <script src="~/javascript/nav.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    @RenderSection("loading", required: false)
    @RenderSection("loading_style", required: false)
    @RenderSection("calculadora_jogo", required: false)
    @RenderSection("conversormoedas_jogo", required: false)
    @RenderSection("conversorimagens_jogo", required: false)
    @RenderSection("falador_jogo", required: false)
    @RenderSection("estilos_imc", required: false)
    @RenderSection("imc_jogo", required: false)
    @RenderSection("Adnum_style", required: false)
    @RenderSection("Adnum_jogo", required: false)
    @RenderSection("principal_js", required: false)
    @RenderSection("calc_style", required: false)
    @RenderSection("f1team_styles", required: false)
    @RenderSection("teams_style", required: false)
    @RenderSection("teams_scripts", required: false)
    @RenderSection("video_styles", required: false)
    @RenderSection("noticias_style", required: false)
    @RenderSection("origens_styles", required: false)
    @RenderSection("sport_styles", required: false)
    @RenderSection("jogos_style", required: false)
    @RenderSection("forcajogo", required: false)
    @RenderSection("forcajogo_style", required: false)
    @RenderSection("api_scripts", required: false)
    @RenderSection("infos_style", required: false)
    @RenderSection("contactos_styles", required: false)
    @RenderSection("falador_styles", required: false)
    @RenderSection("conversormoedas_styles", required: false)
    @RenderSection("conversorimagens_styles", required: false)
    @RenderSection("encriptador_style", required: false)
    @RenderSection("encriptador_jogo", required: false)
    @RenderSection("estilos_detail_piloto", required: false)
    @RenderSection("estilos_detail_equipa", required: false)
    @RenderSection("equipas_style", required: false)
    @RenderSection("music_styles", required: false)
    @RenderSection("creditos_styles", required: false)
    @RenderSection("music_scripts", required: false)
    @RenderSection("treeview_style", required: false)
    @RenderSection("treeview_scripts", required: false)
    @RenderSection("Email_styles", required: false)
    @RenderSection("Email_js", required: false)
    @RenderSection("login_style", required: false)
    @RenderSection("painel_style", required: false)
    @RenderSection("Styles", required: false)
</body>
</html>
