@model F1_website.Models.paginacomunicaçãoviewmodel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Gestão de Componentes</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <div class="mb-3">
            <button type="button" class="btn btn-success" onclick="openAddComponenteModal()">
                <i class="fa fa-plus"></i> Adicionar Componente
            </button>
        </div>

        @if (!Model.ComponentesEF.Any())
        {
            <p>Não existem componentes para esta equipa.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Preço</th>
                        <th>Quantidade</th>
                        <th>Foto</th>
                        <th>Equipa</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ComponentesEF)
                    {
                        var nomeEsc = item.nome?.Replace("'", "\\'");
                        var descEsc = item.descricao?.Replace("'", "\\'");
                        <tr>
                            <td>@item.nome</td>
                            <td>@item.descricao</td>
                            <td>@item.preco</td>
                            <td>@item.quantidade</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.foto))
                                {
                                    <img src="@Url.Content("~/imagens/ImagensComponentes/" + item.foto)" style="max-width: 100px;" />
                                }
                                else
                                {
                                    <span>Sem foto</span>
                                }
                            </td>
                            <td>@item.Equipa?.nome</td>
                            <td>
                                <button class="btn btn-sm btn-warning"
                                        onclick="openEditComponenteModal(@item.id_componente, '@nomeEsc', '@descEsc', @item.preco, @item.quantidade, '@item.foto', @item.Equipa?.id_equipa)">
                                    <i class="fa fa-edit"></i> Editar
                                </button>
                                <a href="@Url.Action("DetailComponente", "Dashboard", new { id = item.id_componente })" class="btn btn-sm btn-info">
                                    <i class="fa fa-eye"></i> Detalhes
                                </a>
                                <button class="btn btn-sm btn-danger"
                                        onclick="openDeleteComponenteModal(@item.id_componente, '@item.nome')">
                                    <i class="fa fa-trash"></i> Apagar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- MODAIS -->
        <!-- Modal: Adicionar Componente -->
        <div class="modal fade" id="addComponenteModal" tabindex="-1" aria-labelledby="addComponenteLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="CreateComponente" asp-controller="Dashboard" method="post" enctype="multipart/form-data">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addComponenteLabel">Adicionar Componente</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">
                                <label>Nome</label>
                                <input type="text" name="nome" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Descrição</label>
                                <textarea name="descricao" class="form-control" required></textarea>
                            </div>
                            <div class="mb-2">
                                <label>Preço</label>
                                <input type="number" step="0.01" name="preco" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Quantidade</label>
                                <input type="number" name="quantidade" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Foto</label>
                                <input type="file" name="fotoFile" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label>Equipa</label>
                                <select name="id_equipa" class="form-control" required>
                                    @foreach (var equipa in Model.EquipasEF)
                                    {
                                        <option value="@equipa.id_equipa">@equipa.nome</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal: Editar Componente -->
        <div class="modal fade" id="editComponenteModal" tabindex="-1" aria-labelledby="editComponenteLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="editComponenteForm" asp-action="EditComponente" asp-controller="Dashboard" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id_componente" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="editComponenteLabel">Editar Componente</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">
                                <label>Nome</label>
                                <input type="text" name="nome" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Descrição</label>
                                <textarea name="descricao" class="form-control" required></textarea>
                            </div>
                            <div class="mb-2">
                                <label>Preço</label>
                                <input type="number" step="0.01" name="preco" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Quantidade</label>
                                <input type="number" name="quantidade" class="form-control" required />
                            </div>
                            <div class="mb-2">
                                <label>Nova Foto</label>
                                <input type="file" name="fotoFile" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label>Equipa</label>
                                <select name="id_equipa" class="form-control" required>
                                    @foreach (var equipa in Model.EquipasEF)
                                    {
                                        <option value="@equipa.id_equipa">@equipa.nome</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Guardar Alterações</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal: Apagar Componente -->
        <div class="modal fade" id="deleteComponenteModal" tabindex="-1" aria-labelledby="deleteComponenteLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="DeleteComponente" asp-controller="Dashboard" method="post">
                        <input type="hidden" name="id_componente" id="deleteComponenteId" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteComponenteLabel">Confirmar Apagar</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <p>Tem a certeza que pretende apagar o componente <strong id="deleteComponenteNome"></strong>?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">Apagar</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function openAddComponenteModal() {
            var modal = new bootstrap.Modal(document.getElementById('addComponenteModal'));
            modal.show();
        }

        function openEditComponenteModal(id, nome, descricao, preco, quantidade, foto, id_equipa) {
            $('#editComponenteForm input[name="id_componente"]').val(id);
            $('#editComponenteForm input[name="nome"]').val(nome);
            $('#editComponenteForm textarea[name="descricao"]').val(descricao);
            $('#editComponenteForm input[name="preco"]').val(preco);
            $('#editComponenteForm input[name="quantidade"]').val(quantidade);
            $('#editComponenteForm select[name="id_equipa"]').val(id_equipa);

            var modal = new bootstrap.Modal(document.getElementById('editComponenteModal'));
            modal.show();
        }

        function openDeleteComponenteModal(id, nome) {
            $('#deleteComponenteId').val(id);
            $('#deleteComponenteNome').text(nome);

            var modal = new bootstrap.Modal(document.getElementById('deleteComponenteModal'));
            modal.show();
        }
    </script>
</body>
</html>
