// Função corrigida para apagar piloto
function deletePiloto(pilotoId) {
    console.log('Tentando apagar piloto ID:', pilotoId);
    $('#loadingModal').modal('show');

    const token = $('input[name="__RequestVerificationToken"]').val();

    if (!token) {
        console.error('Token CSRF não encontrado');
        $('#loadingModal').modal('hide');
        $('#deletePilotoModal').modal('hide');
        showAlert('Erro: Token de segurança não encontrado.', 'error');
        return;
    }

    $.ajax({
        url: '@Url.Action("DeletePiloto", "dashboard")',
        type: 'POST',
        dataType: 'json', // Especificar que esperamos JSON
        data: {
            Id_piloto: pilotoId,
            __RequestVerificationToken: token
        },
        timeout: 15000, // 15 segundos timeout
        success: function(response) {
            console.log('Resposta recebida:', response);
            $('#loadingModal').modal('hide');
            $('#deletePilotoModal').modal('hide');

            // Verificar diferentes formatos de resposta
            let isSuccess = false;
            let message = '';

            if (typeof response === 'object' && response !== null) {
                // Resposta JSON
                isSuccess = response.success === true || response.Success === true;
                message = response.message || response.Message || '';
            } else if (typeof response === 'string') {
                // Resposta como string, tentar fazer parse
                try {
                    const parsed = JSON.parse(response);
                    isSuccess = parsed.success === true || parsed.Success === true;
                    message = parsed.message || parsed.Message || '';
                } catch (e) {
                    // Se não conseguir fazer parse, assumir sucesso se não houver erro explícito
                    isSuccess = !response.toLowerCase().includes('erro');
                    message = response;
                }
            }

            if (isSuccess) {
                // Sucesso - remover da interface
                $(`#piloto-row-${pilotoId}`).fadeOut(500, function() {
                    $(this).remove();

                    // Verificar se tabela ficou vazia
                    if ($('#pilotosTable tbody tr:visible').length === 0) {
                        $('#pilotosTable').replaceWith(`
                            <div class="f1-no-data">
                                <p>Nenhum piloto encontrado.</p>
                            </div>
                        `);
                    }
                });

                showAlert(message || 'Piloto apagado com sucesso!', 'success');
            } else {
                showAlert(message || 'Erro ao apagar piloto.', 'error');
            }
        },
        error: function(xhr, status, error) {
            console.error('Erro AJAX:', {
                status: xhr.status,
                statusText: xhr.statusText,
                responseText: xhr.responseText,
                ajaxStatus: status,
                error: error
            });

            $('#loadingModal').modal('hide');
            $('#deletePilotoModal').modal('hide');

            // Se o status for 200, pode ser que foi apagado mas houve problema na resposta
            if (xhr.status === 200 || xhr.status === 0) {
                console.log('Status 200/0 - verificando se foi apagado...');

                // Tentar verificar se a resposta contém indicação de sucesso
                let responseText = xhr.responseText || '';
                if (responseText.includes('success') || responseText.includes('Success') ||
                    responseText.toLowerCase().includes('apagado') ||
                    responseText.toLowerCase().includes('deleted')) {

                    // Assumir que foi apagado com sucesso
                    $(`#piloto-row-${pilotoId}`).fadeOut(500, function() {
                        $(this).remove();

                        if ($('#pilotosTable tbody tr:visible').length === 0) {
                            $('#pilotosTable').replaceWith(`
                                <div class="f1-no-data">
                                    <p>Nenhum piloto encontrado.</p>
                                </div>
                            `);
                        }
                    });

                    showAlert('Piloto apagado com sucesso!', 'success');
                    return;
                }
            }

            // Erro real
            let errorMessage = 'Erro ao apagar piloto.';

            if (status === 'timeout') {
                errorMessage = 'A operação demorou muito tempo. Verifique se foi apagado.';
            } else if (xhr.status === 404) {
                errorMessage = 'Piloto não encontrado.';
            } else if (xhr.status === 500) {
                errorMessage = 'Erro interno do servidor.';
            } else if (xhr.status === 403) {
                errorMessage = 'Não tem permissão para apagar este piloto.';
            } else if (xhr.responseJSON && xhr.responseJSON.message) {
                errorMessage = xhr.responseJSON.message;
            } else if (xhr.responseText) {
                // Tentar extrair mensagem de erro do HTML
                const tempDiv = $('<div>').html(xhr.responseText);
                const errorDiv = tempDiv.find('.alert-danger, .error, .validation-summary-errors');
                if (errorDiv.length > 0) {
                    errorMessage = errorDiv.text().trim();
                }
            }

            showAlert(errorMessage, 'error');
        },
        complete: function(xhr, status) {
            console.log('Requisição completada com status:', status);
            // Garantir que loading modal é sempre fechado
            setTimeout(function() {
                $('#loadingModal').modal('hide');
            }, 100);
        }
    });
}

// Função alternativa usando fetch (mais moderna)
async function deletePilotoFetch(pilotoId) {
    console.log('Usando fetch para apagar piloto ID:', pilotoId);
    $('#loadingModal').modal('show');

    const token = $('input[name="__RequestVerificationToken"]').val();

    if (!token) {
        $('#loadingModal').modal('hide');
        $('#deletePilotoModal').modal('hide');
        showAlert('Erro: Token de segurança não encontrado.', 'error');
        return;
    }

    try {
        const formData = new FormData();
        formData.append('Id_piloto', pilotoId);
        formData.append('__RequestVerificationToken', token);

        const response = await fetch('@Url.Action("DeletePiloto", "dashboard")', {
            method: 'POST',
            body: formData
        });

        console.log('Response status:', response.status);
        console.log('Response ok:', response.ok);

        $('#loadingModal').modal('hide');
        $('#deletePilotoModal').modal('hide');

        if (response.ok) {
            // Sucesso
            $(`#piloto-row-${pilotoId}`).fadeOut(500, function() {
                $(this).remove();

                if ($('#pilotosTable tbody tr:visible').length === 0) {
                    $('#pilotosTable').replaceWith(`
                        <div class="f1-no-data">
                            <p>Nenhum piloto encontrado.</p>
                        </div>
                    `);
                }
            });

            showAlert('Piloto apagado com sucesso!', 'success');
        } else {
            const errorText = await response.text();
            console.error('Erro na resposta:', errorText);
            showAlert('Erro ao apagar piloto.', 'error');
        }

    } catch (error) {
        console.error('Erro fetch:', error);
        $('#loadingModal').modal('hide');
        $('#deletePilotoModal').modal('hide');
        showAlert('Erro de conexão ao apagar piloto.', 'error');
    }
}

// Função melhorada para mostrar alertas
function showAlert(message, type = 'success') {
    // Remover alertas existentes
    $('.f1-alert').remove();

    const alertClass = type === 'success' ? 'f1-alert-success' : 'f1-alert-danger';
    const alertHtml = `
        <div class="f1-alert ${alertClass}" style="margin-top: 15px;">
            ${message}
            <button type="button" class="close" onclick="$(this).parent().fadeOut(300, function(){ $(this).remove(); })">
                <span>&times;</span>
            </button>
        </div>
    `;

    $('.f1-export-section').after(alertHtml);

    // Auto remove após 6 segundos
    setTimeout(() => {
        $('.f1-alert').fadeOut(500, function() {
            $(this).remove();
        });
    }, 6000);
}

// Event listeners
$(document).ready(function () {
    let deleteInProgress = false;

    // Botão de confirmar delete
    $('#confirmDeleteBtn').off('click').on('click', function() {
        if (deleteInProgress) {
            console.log('Delete já em progresso, ignorando...');
            return;
        }

        console.log('Botão delete clicado, piloto ID:', currentPilotoId);

        if (currentPilotoId) {
            deleteInProgress = true;

            // Usar fetch em vez de AJAX (mais confiável)
            deletePilotoFetch(currentPilotoId).finally(() => {
                deleteInProgress = false;
            });

            // Alternativa: usar AJAX melhorado
            // deletePiloto(currentPilotoId);
        } else {
            console.error('currentPilotoId é null');
            $('#deletePilotoModal').modal('hide');
            showAlert('Erro: ID do piloto não encontrado.', 'error');
        }
    });

    // Reset quando modal é fechado
    $('#deletePilotoModal').on('hidden.bs.modal', function () {
        currentPilotoId = null;
        deleteInProgress = false;
        console.log('Modal delete fechado');
    });

    // Limpar loading modal se ficar preso
    setInterval(function() {
        if ($('#loadingModal').hasClass('show') && !deleteInProgress) {
            console.warn('Forçando fechamento do loading modal');
            $('#loadingModal').modal('hide');
        }
    }, 10000);
});    
    </script>
}