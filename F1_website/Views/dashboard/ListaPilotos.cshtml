@model F1_website.Models.paginacomunicaçãoviewmodel
@{
    ViewBag.Title = "ListaPilotos";
    Layout = "~/Views/Shared/Dashboard_layout.cshtml";
}
@section Styles{
    <link rel="stylesheet" href="~/estilos/equipas_dashboard_styles.css" />
}

<div class="f1-table-container">
    <h2 class="f1-page-title">ListaPilotos</h2>

    <div class="f1-export-section">
        <button type="button" class="f1-btn f1-btn-add" onclick="openAddPilotoModal()">
            <i class="fa fa-plus"></i> Adicionar Novo Piloto
        </button>

        <div class="f1-export-group">
            <a href="@Url.Action("ExportarPilotosExcel", "dashboard")" class="f1-btn f1-btn-export f1-btn-export-excel">
                <i class="fas fa-file-excel"></i> Exportar Excel
            </a>
            <a href="@Url.Action("ExportarPilotosPDF", "dashboard")" class="f1-btn f1-btn-export f1-btn-export-pdf">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Msg as string))
    {
        <div class="f1-alert f1-alert-success">
            @ViewBag.Msg
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (Model?.PilotoEF != null && Model.PilotoEF.Any())
    {
        <table class="f1-table" id="pilotosTable">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Nacionalidade</th>
                    <th>Data Nascimento</th>
                    <th>Equipa</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var piloto in Model.PilotoEF)
                {
                    var nomeEscaped = piloto.nome?.Replace("'", "\\'");
                    var nacionalidadeEscaped = piloto.nacionalidade?.Replace("'", "\\'");
                    <tr id="piloto-row-@piloto.Id_piloto">
                        <td>@piloto.nome</td>
                        <td>@piloto.nacionalidade</td>
                        <td>@(piloto.data_nascimento?.ToShortDateString() ?? "-")</td>
                        <td>@(piloto.Equipa?.nome ?? "-")</td>
                        <td>
                            <button class="f1-btn f1-btn-edit" onclick="openEditPilotoModal(@piloto.Id_piloto, '@nomeEscaped', '@nacionalidadeEscaped', '@(piloto.data_nascimento?.ToString("yyyy-MM-dd") ?? "")')">
                                <i class="fa fa-edit"></i> Editar
                            </button>
                            @Html.ActionLink("Details", "DetailPiloto", new { id = piloto.Id_piloto }, new { @class = "f1-btn f1-btn-info" })
                            <button class="f1-btn f1-btn-danger" onclick="openDeletePilotoModal(@piloto.Id_piloto, '@nomeEscaped')">
                                <i class="fa fa-trash"></i> Apagar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="f1-no-data">
            <p>Nenhum piloto encontrado.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.Erro as string))
    {
        <div class="f1-alert f1-alert-danger">
            <p>Erro: @ViewBag.Erro</p>
        </div>
    }
</div>

<!-- Modal para Adicionar Piloto -->
<div class="modal fade" id="addPilotoModal" tabindex="-1" role="dialog" aria-labelledby="addPilotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPilotoModalLabel">Adicionar Novo Piloto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            @using (Html.BeginForm("AddPiloto", "dashboard", FormMethod.Post, new { enctype = "multipart/form-data", @id = "addPilotoForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            <label class="control-label col-md-3">Nome *</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="Piloto.nome" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Nacionalidade</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="Piloto.nacionalidade" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Data de Nascimento</label>
                            <div class="col-md-9">
                                <input type="date" class="form-control" name="Piloto.data_nascimento" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Equipa</label>
                            <div class="col-md-9">
                                <select name="Piloto.equipa_id" class="form-control">
                                    <option value="">-- Selecionar Equipa --</option>
                                    @foreach (var equipa in Model.EquipasEF)
                                    {
                                        <option value="@equipa.id_equipa">@equipa.nome</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Guardar Piloto
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Editar Piloto -->
<div class="modal fade" id="editPilotoModal" tabindex="-1" role="dialog" aria-labelledby="editPilotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPilotoModalLabel">Editar Piloto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            @using (Html.BeginForm("EditarPiloto", "dashboard", FormMethod.Post, new { enctype = "multipart/form-data", @id = "editPilotoForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id_piloto" />

                <div class="modal-body">
                    <div class="form-horizontal">

                        <div class="form-group">
                            <label class="control-label col-md-3">Nome *</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="nome" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Nacionalidade</label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="nacionalidade" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-3">Data de Nascimento</label>
                            <div class="col-md-9">
                                <input type="date" class="form-control" name="data_nascimento" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Atualizar Piloto
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Apagar Piloto -->
<div class="modal fade" id="deletePilotoModal" tabindex="-1" role="dialog" aria-labelledby="deletePilotoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deletePilotoModalLabel">Confirmar Apagar Piloto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <p>Tem a certeza que quer apagar o piloto <strong id="deletePilotoNome"></strong>?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fa fa-trash"></i> Apagar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border" role="status">
                    <span class="sr-only">A processar...</span>
                </div>
                <p class="mt-2">A processar...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

    <script>
        let currentPilotoId = null;

        function openAddPilotoModal() {
            $('#addPilotoModal').modal('show');
        }

        function openEditPilotoModal(id, nome, nacionalidade, data_nascimento) {
            $('#editPilotoForm input[name="Id_piloto"]').val(id);
            $('#editPilotoForm input[name="nome"]').val(nome);
            $('#editPilotoForm input[name="nacionalidade"]').val(nacionalidade);
            $('#editPilotoForm input[name="data_nascimento"]').val(data_nascimento);
            $('#editPilotoModal').modal('show');
        }

        function openDeletePilotoModal(id, nome) {
            currentPilotoId = id;
            $('#deletePilotoNome').text(nome);
            $('#deletePilotoModal').modal('show');
        }

        function showAlert(message, type = 'success') {
            const alertClass = type === 'success' ? 'f1-alert-success' : 'f1-alert-danger';
